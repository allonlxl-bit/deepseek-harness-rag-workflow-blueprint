{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/plugin-indexed-rag-harness/workflow-plan.schema.json",
  "title": "Deterministic Workflow Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "workflow_id", "brand", "task_type", "nodes", "production_write", "idempotency_key"],
  "properties": {
    "status": {"enum": ["PASS_WORKFLOW_PLAN", "HOLD"]},
    "workflow_id": {"type": "string", "minLength": 1},
    "brand": {"type": "string", "minLength": 1},
    "task_type": {"enum": ["technical_solution", "blog", "product_detail"]},
    "product": {"type": "string"},
    "route_file": {"type": "string"},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "depends_on"], "properties": {"id": {"type": "string"}, "depends_on": {"type": "array", "items": {"type": "string"}}}}},
    "missing_inputs": {"type": "array", "items": {"type": "string"}},
    "production_write": {"type": "boolean", "const": false},
    "idempotency_key": {"type": "string", "minLength": 8}
  }
}
