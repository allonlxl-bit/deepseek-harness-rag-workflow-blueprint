{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/plugin-indexed-rag-harness/plugin-manifest.schema.json",
  "title": "Enterprise Capability Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "capabilities", "scopes", "permissions", "depends_on"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.-]+)?$"},
    "capabilities": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "scopes": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "permissions": {"type": "array", "items": {"enum": ["read_only", "candidate_write", "production_write", "network_access", "sender", "ota"]}, "uniqueItems": true},
    "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "production_write": {"type": "boolean", "const": false}
  }
}
